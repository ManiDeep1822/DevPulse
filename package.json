{
  "name": "devpulse",
  "version": "1.0.0",
  "description": "DevPulse - Agile Kanban Task Management Platform (MERN Stack)",
  "author": "Indla Mohana Venkata Mani Deep",
  "license": "MIT",
  "scripts": {
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "install:all": "npm run install:server && npm run install:client",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "concurrently --kill-others-on-fail -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run server\" \"npm run client\"",
    "seed": "cd server && npm run seed",
    "test": "cd server && npm run test",
    "build": "cd client && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
